# ============================================
# RTX System — متغيرات البيئة (نموذج)
# ============================================
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية.
# لا ترفع .env إلى GitHub أبداً (.gitignore يتجاهله تلقائياً).
# ============================================

# --- قاعدة البيانات (PostgreSQL) ---
# الصيغة: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://rtx:CHANGE_ME@localhost:5432/rtx?schema=public"

# --- أسرار التطبيق ---
# مفتاح JWT — استخدم string عشوائي طويل (32+ حرف).
# توليد واحد سريع: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"

# --- إعدادات التشغيل ---
NEXT_PUBLIC_SITE_URL="https://rtx.openappo.com"
NODE_ENV=production

# المنفذ الداخلي للكونتينر — لازم يطابق EXPOSE في Dockerfile
# وإعداد proxy_pass في Nginx.
# 3000 = OpenGym | 3001 = Mazaya | 3006 = RTX
PORT=3006
HOSTNAME=0.0.0.0
